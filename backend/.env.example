WAJBATI_ENV=development
WAJBATI_TZ=Asia/Baghdad
WAJBATI_SEED_DEMO=true
DATABASE_URL=sqlite:///./wajbati.db
# Production: set WAJBATI_ENV=production and WAJBATI_SEED_DEMO=false.
# WAJBATI_SECRET must be a private random signing key.
# On the first production start, configure a JSON map of every cafeteria name
# to a private code of 12-72 ASCII characters:
# WAJBATI_CAFETERIA_CODES={...}
# FCM_SERVICE_ACCOUNT_FILE=/private/path/service-account.json
